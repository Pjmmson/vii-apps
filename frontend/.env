# =========================================================================
# APPLICATION CORE CONFIGURATION
# =========================================================================
# The environment mode (Vite defaults this based on how you run npm)
NODE_ENV=production

# The public name of your application shown in headers/titles
VITE_APP_NAME="My Fullstack App"


# =========================================================================
# LARAVEL BACKEND CONNECTION (API & SANCTUM HANDSHAKE)
# =========================================================================
# The URL pointing to your Nginx-Laravel container gateway.
# Use http://localhost:8000 for local Docker development, or your custom domain 
# (e.g., https://yourdomain.com) if deploying to a remote cloud VPS.
# VITE_API_URL=http://localhost:5566
VITE_API_URL=http://127.0.0.1:8000

# =========================================================================
# OPTIONAL INTEGRATIONS & DEV TOOLS
# =========================================================================
# Timeout threshold for your global Axios network requests (in milliseconds)
VITE_API_TIMEOUT=10000

# Toggle code telemetry, error logging, or console output in production
VITE_ENABLE_LOGS=false
